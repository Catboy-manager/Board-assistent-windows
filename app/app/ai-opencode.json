{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "external_directory": {
      "*": "allow",
      "~/secrets/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/opencode/**": "deny",
      "~/.local/share/opencode/**": "deny",
      "~/.aws/**": "deny",
      "~/.kube/**": "deny"
    },
    "edit": {
      "**": "allow",
      "~/secrets/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/opencode/**": "deny",
      "~/.local/share/opencode/**": "deny",
      "~/.aws/**": "deny",
      "~/.kube/**": "deny"
    },
    "bash": {
      "*": "allow",
      "*sudo*": "deny",
      "*shutdown*": "deny",
      "*poweroff*": "deny",
      "*reboot*": "deny",
      "*killall*": "deny",
      "*kill -9*": "deny",
      "*mkfs*": "deny",
      "*fdisk*": "deny",
      "*dd if=*": "deny",
      "* rm -rf /*": "deny",
      "* rm -rf ~*": "deny",
      "*--no-preserve-root*": "deny",
      "*curl * |*sh*": "deny",
      "*curl *|*sh*": "deny",
      "*wget * && *sh*": "deny",
      "*base64 -d*": "deny",
      "*systemctl stop*": "deny",
      "*systemctl disable*": "deny",
      "*systemctl halt*": "deny",
      "*init 0*": "deny",
      "*init 6*": "deny",
      "*passwd*": "deny",
      "*useradd*": "deny",
      "*userdel*": "deny",
      "*chmod 777 /*": "deny",
      "*chown*": "deny",
      "*> /dev/sd*": "deny",
      "*diskutil erase*": "deny",
      "*/etc/shadow*": "deny",
      "*crontab -e*": "deny",
      "*atkbd*": "deny"
    },
    "question": "deny"
  }
}
