{
  "name": "kanban-desktop",
  "version": "1.3.0",
  "productName": "Kanban Board",
  "description": "Desktop version: kanban board + AI assistant + voice.",
  "main": "main.js",
  "author": "Kanban Board contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis portable",
    "dist:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "ru.kanban.desktop",
    "productName": "Kanban Board",
    "asar": false,
    "files": ["main.js", "app/**", "build/**", "package.json"],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kanban Board"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}